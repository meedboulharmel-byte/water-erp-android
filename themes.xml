<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WaterERP" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/teal_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_600</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:fitsSystemWindows">false</item>
    </style>

    <style name="Theme.WaterERP.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/teal_700</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/teal_700</item>
        <item name="postSplashScreenTheme">@style/Theme.WaterERP</item>
    </style>
</resources>
